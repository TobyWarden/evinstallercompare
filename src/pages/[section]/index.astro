---
// Places hub: every county and town with a page, A to Z (like installsolar's /places/ and comparefactors' /areas/).
import Layout from '../../layouts/Layout.astro';
import { vertical, getDirectory } from '../../lib/data';
import { plural, sourcesLine, titleCase } from '../../lib/summary';

export function getStaticPaths() {
  return [{ params: { section: vertical.locationPath } }];
}

const { counties, installers, towns, lastChecked } = getDirectory();
const letters = [...new Set(counties.map((c) => c.name[0].toUpperCase()))];
---

<Layout
  title={`${titleCase(vertical.trades)} by County and Town`}
  description={`Browse ${plural(installers.length, vertical.trade)} across ${plural(towns.length, 'town')} and ${plural(counties.length, 'county', 'counties')}.`}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Places' }]}
>
  <h1 class="text-3xl font-bold">{vertical.trades} by county and town</h1>
  <p class="mt-3 max-w-2xl text-slate-600">
    {plural(installers.length, 'installer')} across {plural(towns.length, 'town')} in {plural(counties.length, 'county', 'counties')}. Towns in grey have fewer installers listed so far.
  </p>
  <p class="mt-2 text-xs text-slate-500">{sourcesLine(lastChecked)}</p>

  {letters.length > 1 && (
    <nav aria-label="Jump to letter" class="mt-6 flex flex-wrap gap-2 text-sm">
      {letters.map((l) => <a href={`#letter-${l}`} class="rounded border border-slate-200 bg-white px-2 py-1 text-emerald-800 hover:bg-emerald-50">{l}</a>)}
    </nav>
  )}

  {counties.length === 0 ? (
    <p class="mt-8 rounded border border-slate-200 bg-white p-4 text-slate-600">No places listed yet.</p>
  ) : (
    <div class="mt-8 space-y-6">
      {letters.map((l) => (
        <section id={`letter-${l}`} class="scroll-mt-4">
          <h2 class="text-lg font-semibold text-slate-500">{l}</h2>
          {counties.filter((c) => c.name[0].toUpperCase() === l).map((c) => (
            <div class="mt-3 rounded border border-slate-200 bg-white p-4">
              <a href={c.url} class="font-medium text-emerald-800 hover:underline">{c.name}</a>
              <span class="text-sm text-slate-500"> · {plural(c.installers.length, 'installer')}</span>
              <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {[...c.towns].sort((a, b) => a.name.localeCompare(b.name)).map((t) => (
                  <li><a href={t.url} class={t.indexable ? 'text-emerald-800 hover:underline' : 'text-slate-500 hover:underline'}>{t.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </div>
  )}
</Layout>
