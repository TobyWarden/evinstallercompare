---
import Layout from '../../../layouts/Layout.astro';
import StatCard from '../../../components/StatCard.astro';
import InstallerCard from '../../../components/InstallerCard.astro';
import Faq from '../../../components/Faq.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import { config, vertical, placesUrl, getDirectory, type Town } from '../../../lib/data';
import { summarise, locationFaqs, plural, radiusRule, sourcesLine, dataYear, titleCase, formatDate } from '../../../lib/summary';

export function getStaticPaths() {
  return getDirectory().towns.map((town) => ({ params: { section: vertical.locationPath, county: town.county.slug, town: town.slug }, props: { town } }));
}

const { town } = Astro.props as { town: Town };
const { counties, lastChecked } = getDirectory();
const county = counties.find((c) => c.slug === town.county.slug)!;
const s = summarise(town.installers);
const cert = vertical.certification;
const minListings = config.directory.minInstallersForLocationPage;
const year = dataYear(lastChecked);
const intro = [
  `We list ${plural(s.total, `${cert.approvedAdj} installer`)} near ${town.name}, ${town.county.name}.`,
  s.commercial > 0 && `${s.commercial} of them install for businesses as well as homes.`,
  s.medianYears !== null && `The typical one has been trading for ${plural(s.medianYears, 'year')}.`,
].filter(Boolean).join(' ');
const title = `${titleCase(vertical.trades)} in ${town.name}: ${plural(s.total, `${cert.approvedAdj} Firm`)}${year ? ` (${year})` : ''}`;
---

<Layout
  title={title}
  description={`Check ${plural(s.total, `${cert.approvedAdj} ${vertical.trade}`)} near ${town.name}, ${town.county.name} before you sign: ${cert.name} status, years trading and areas covered.`}
  noindex={!town.indexable}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Places', url: placesUrl }, { name: town.county.name, url: town.county.url }, { name: town.name }]}
>
  <p class="text-xs font-semibold uppercase tracking-wide text-emerald-800">Town · {town.county.name}</p>
  <h1 class="mt-1 text-3xl font-bold">{vertical.trades} in {town.name}</h1>
  <p class="mt-3 max-w-2xl text-slate-600">{intro}</p>
  <p class="mt-2 text-xs text-slate-500">{sourcesLine(lastChecked)}</p>

  {!town.indexable && (
    <div class="mt-6 rounded border border-amber-300 bg-amber-50 p-4 text-sm">
      Only {plural(s.total, 'installer is', 'installers are')} listed near {town.name} so far (we need {minListings} for a full town page).{' '}
      <a href={town.county.url} class="font-medium text-emerald-800 underline">See all {plural(county.installers.length, 'installer')} in {town.county.name}</a>.
    </div>
  )}

  <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <StatCard label="Installers listed" value={s.total} note={lastChecked ? `${cert.name} list, ${formatDate(lastChecked)}` : undefined} />
    <StatCard label="Homes and businesses" value={s.commercial} note={`Of ${s.total}`} />
    <StatCard label="Homes only" value={s.homeOnly} note={`Of ${s.total}`} />
    <StatCard
      label="Typical years trading"
      value={s.medianYears ?? 'Not known'}
      note={s.medianYears !== null ? `Median of ${plural(s.withYears, 'registered company', 'registered companies')}` : undefined}
    />
  </dl>

  <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
    <a href="#installers" class="font-medium text-emerald-800 underline">See all {plural(s.total, 'installer')}</a>
    <a href="#quote" class="text-emerald-800 underline">Get quotes</a>
    <a href="#nearby" class="text-emerald-800 underline">Nearby</a>
    <a href="#faqs" class="text-emerald-800 underline">FAQ</a>
  </nav>

  <section id="installers" class="mt-8 scroll-mt-4">
    <h2 class="text-xl font-semibold">All {plural(s.total, 'installer')} near {town.name}</h2>
    <p class="mt-1 text-sm text-slate-500">Nearest first, listed when based {radiusRule} of the town centre. Placement can't be bought.</p>
    <ul class="mt-4 divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      {town.installers.map((installer) => <InstallerCard installer={installer} />)}
    </ul>
  </section>

  <QuoteForm area={`${town.name}, ${town.county.name}`} heading={`Get quotes in ${town.name}`} />

  <!-- Reserved for a map of installers. Keep it within config.build.maxPageKb when it's added. -->
  <section id="map" class="mt-12" data-map-slot></section>

  <section id="nearby" class="mt-12 grid scroll-mt-4 gap-8 sm:grid-cols-2">
    {town.nearby.length > 0 && (
      <div>
        <h2 class="text-xl font-semibold">Nearby towns</h2>
        <ul class="mt-3 space-y-1">
          {town.nearby.map((n) => (
            <li><a href={n.url} class="text-emerald-800 hover:underline">{n.name}</a> <span class="text-sm text-slate-500">({plural(n.count, 'installer')})</span></li>
          ))}
        </ul>
      </div>
    )}
    <div>
      <h2 class="text-xl font-semibold">{town.county.name}</h2>
      <p class="mt-3"><a href={town.county.url} class="text-emerald-800 hover:underline">All {plural(county.installers.length, 'installer')} across {plural(county.towns.length, 'town')} in {town.county.name}</a></p>
    </div>
  </section>

  <Faq items={locationFaqs(town.name, s, lastChecked, 'town')} />

  <p class="mt-8 text-xs text-slate-500">
    {lastChecked && <>{cert.name} list checked {formatDate(lastChecked)} · </>}<a href="/methodology/" class="underline">How this page is counted</a>
  </p>
</Layout>
