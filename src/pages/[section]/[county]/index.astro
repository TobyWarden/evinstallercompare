---
import Layout from '../../../layouts/Layout.astro';
import StatCard from '../../../components/StatCard.astro';
import InstallerCard from '../../../components/InstallerCard.astro';
import Faq from '../../../components/Faq.astro';
import { vertical, placesUrl, getDirectory, type County } from '../../../lib/data';
import { summarise, locationFaqs, plural, sourcesLine, dataYear, titleCase, formatDate } from '../../../lib/summary';

export function getStaticPaths() {
  return getDirectory().counties.map((county) => ({ params: { section: vertical.locationPath, county: county.slug }, props: { county } }));
}

const { county } = Astro.props as { county: County };
const { lastChecked } = getDirectory();
const s = summarise(county.installers);
const cert = vertical.certification;
const year = dataYear(lastChecked);
const towns = [...county.towns].sort((a, b) => b.installers.length - a.installers.length || a.name.localeCompare(b.name));
const busiest = towns.slice(0, 3).map((t) => t.name);
const intro = [
  `We list ${plural(s.total, `${cert.approvedAdj} installer`)} across ${plural(county.towns.length, 'town')} in ${county.name}.`,
  busiest.length > 1 && `Most are near ${busiest.slice(0, -1).join(', ')} and ${busiest.at(-1)}.`,
  s.commercial > 0 && `${s.commercial} of them install for businesses as well as homes.`,
].filter(Boolean).join(' ');
---

<Layout
  title={`${titleCase(vertical.trades)} in ${county.name}: ${plural(s.total, `${cert.approvedAdj} Firm`)} Compared${year ? ` (${year})` : ''}`}
  description={`Compare ${plural(s.total, `${cert.approvedAdj} ${vertical.trade}`)} across ${plural(county.towns.length, 'town')} in ${county.name}: ${cert.name} status, years trading and areas covered.`}
  noindex={!county.indexable}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Places', url: placesUrl }, { name: county.name }]}
>
  <p class="text-xs font-semibold uppercase tracking-wide text-emerald-800">County</p>
  <h1 class="mt-1 text-3xl font-bold">{vertical.trades} in {county.name}</h1>
  <p class="mt-3 max-w-2xl text-slate-600">{intro}</p>
  <p class="mt-2 text-xs text-slate-500">{sourcesLine(lastChecked)}</p>

  <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <StatCard label="Installers listed" value={s.total} note={lastChecked ? `${cert.name} list, ${formatDate(lastChecked)}` : undefined} />
    <StatCard label="Towns covered" value={county.towns.length} />
    <StatCard label="Homes and businesses" value={s.commercial} note={`Of ${s.total}`} />
    <StatCard
      label="Typical years trading"
      value={s.medianYears ?? 'Not known'}
      note={s.medianYears !== null ? `Median of ${plural(s.withYears, 'registered company', 'registered companies')}` : undefined}
    />
  </dl>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Towns in {county.name}</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {towns.map((t) => (
        <li class="rounded border border-slate-200 bg-white px-4 py-3">
          <a href={t.url} class="font-medium text-emerald-800 hover:underline">{t.name}</a>
          <span class="text-sm text-slate-500"> · {plural(t.installers.length, 'installer')}</span>
        </li>
      ))}
    </ul>
  </section>

  <p class="mt-8"><a href="#installers" class="font-medium text-emerald-800 underline">See all {plural(s.total, 'installer')}</a></p>

  <section id="installers" class="mt-6 scroll-mt-4">
    <h2 class="text-xl font-semibold">All installers in {county.name}</h2>
    <p class="mt-1 text-sm text-slate-500">A to Z. Placement can't be bought.</p>
    <ul class="mt-4 divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      {county.installers.map((installer) => <InstallerCard installer={installer} />)}
    </ul>
  </section>

  <!-- Reserved for a map of installers. Keep it within config.build.maxPageKb when it's added. -->
  <section id="map" class="mt-12" data-map-slot></section>

  <Faq items={locationFaqs(county.name, s, lastChecked, 'county')} />

  <p class="mt-8 text-xs text-slate-500">
    {lastChecked && <>{cert.name} list checked {formatDate(lastChecked)} · </>}<a href="/methodology/" class="underline">How this page is counted</a>
  </p>
</Layout>
