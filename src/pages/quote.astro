---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { vertical } from '../lib/data';
---

<Layout title="Get quotes" description={`Request ${vertical.product} installation quotes for your home or business.`}>
  <h1 class="text-3xl font-bold">Get {vertical.product} quotes</h1>
  <p class="mt-2 max-w-2xl text-slate-600">For homes, flats, workplaces, car parks and apartment blocks anywhere in the UK.</p>
  <QuoteForm heading="Tell us about your installation" readQuery />
</Layout>
