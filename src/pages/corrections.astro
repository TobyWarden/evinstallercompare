---
import Layout from '../layouts/Layout.astro';
import { config, getCorrections, getInstallers } from '../lib/data';
import { formatDate } from '../lib/summary';

const corrections = getCorrections();
const bySlug = new Map(getInstallers().map((i) => [i.slug, i]));
---

<Layout title="Corrections" description={`Changes made to ${config.site.name} listings after someone told us something was wrong.`}>
  <h1 class="text-3xl font-bold">Corrections</h1>
  <p class="mt-3 max-w-2xl text-slate-600">
    When a listing is wrong, we check the fix against a public source, update the listing and log it here. To report something, use our <a href="/claim/" class="text-emerald-800 underline">claim or correct form</a>.
  </p>

  {corrections.length === 0 ? (
    <p class="mt-8 rounded border border-slate-200 bg-white p-4 text-slate-600">No corrections yet.</p>
  ) : (
    <ul class="mt-8 divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      {corrections.map((c) => {
        const ins = bySlug.get(c.installer_slug);
        return (
          <li class="p-4">
            <p class="text-sm text-slate-500">{formatDate(c.date)}{ins && <> · <a href={ins.url} class="text-emerald-800 underline">{ins.company_name}</a></>}</p>
            <p class="mt-1">{c.what_changed}</p>
            <p class="mt-1 text-xs text-slate-500">
              Checked against {c.source_url ? <a href={c.source_url} class="underline" rel="nofollow noopener">{c.source}</a> : c.source}, {formatDate(c.retrieved_at)}.
            </p>
          </li>
        );
      })}
    </ul>
  )}
</Layout>
