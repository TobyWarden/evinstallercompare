---
import Layout from '../../layouts/Layout.astro';
import { config } from '../../lib/data';

const waitlist = config.quote.mode === 'waitlist';
---

<Layout title="Thanks" description="Your enquiry has been received." noindex>
  <h1 class="text-3xl font-bold">Thanks, we've got your details</h1>
  <p class="mt-3 max-w-2xl text-slate-600">
    {waitlist
      ? "We're setting up introductions with installers and will be in touch as soon as we can put you in touch with one near you."
      : "We'll pass your enquiry to suitable installers near you."}
  </p>
  <p class="mt-6"><a href="/" class="font-medium text-emerald-800 underline">Back to the homepage</a></p>
</Layout>
