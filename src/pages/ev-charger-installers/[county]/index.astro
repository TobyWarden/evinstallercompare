---
import Layout from '../../../layouts/Layout.astro';
import StatCard from '../../../components/StatCard.astro';
import InstallerCard from '../../../components/InstallerCard.astro';
import Faq from '../../../components/Faq.astro';
import { getDirectory, type County } from '../../../lib/data';
import { summarise, locationFaqs, plural } from '../../../lib/summary';

export function getStaticPaths() {
  return getDirectory().counties.map((county) => ({ params: { county: county.slug }, props: { county } }));
}

const { county } = Astro.props as { county: County };
const { lastChecked } = getDirectory();
const s = summarise(county.installers);
const intro = [
  `We list ${plural(s.total, 'OZEV-approved installer')} across ${plural(county.towns.length, 'town')} in ${county.name}.`,
  s.commercial > 0 && `${s.commercial} of them install chargers for businesses as well as homes.`,
  "Pick a town to see who's nearest, or compare everyone below.",
].filter(Boolean).join(' ');
const towns = [...county.towns].sort((a, b) => b.installers.length - a.installers.length || a.name.localeCompare(b.name));
---

<Layout
  title={`EV charger installers in ${county.name}`}
  description={`Compare ${plural(s.total, 'OZEV-approved EV charger installer')} across ${plural(county.towns.length, 'town')} in ${county.name}.`}
  noindex={!county.indexable}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: county.name }]}
>
  <h1 class="text-3xl font-bold">EV charger installers in {county.name}</h1>
  <p class="mt-3 max-w-2xl text-slate-600">{intro}</p>

  <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <StatCard label="Installers listed" value={s.total} />
    <StatCard label="Towns covered" value={county.towns.length} />
    <StatCard label="Homes and businesses" value={s.commercial} />
    <StatCard
      label="Typical years trading"
      value={s.medianYears ?? 'Not known'}
      note={s.medianYears !== null ? `Median of ${plural(s.withYears, 'registered company', 'registered companies')}` : undefined}
    />
  </dl>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Towns in {county.name}</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {towns.map((t) => (
        <li class="rounded border border-slate-200 bg-white px-4 py-3">
          <a href={t.url} class="font-medium text-emerald-800 hover:underline">{t.name}</a>
          <span class="text-sm text-slate-500"> · {plural(t.installers.length, 'installer')}</span>
        </li>
      ))}
    </ul>
  </section>

  <p class="mt-8"><a href="#installers" class="font-medium text-emerald-800 underline">See all {plural(s.total, 'installer')}</a></p>

  <section id="installers" class="mt-6 scroll-mt-4">
    <h2 class="text-xl font-semibold">All installers in {county.name}</h2>
    <ul class="mt-4 divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      {county.installers.map((installer) => <InstallerCard installer={installer} />)}
    </ul>
  </section>

  <!-- Reserved for a map of installers. Keep it within config.build.maxPageKb when it's added. -->
  <section id="map" class="mt-12" data-map-slot></section>

  <Faq items={locationFaqs(county.name, s, lastChecked, 'county')} />
</Layout>
